# ─── REVERIE — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# NEVER commit a real .env file. The .gitignore already blocks it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Cloud ──────────────────────────────────────────────────────────────
# Your GCP project ID (required for Vertex AI, Firestore, Cloud Storage)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region for Vertex AI / Cloud Run. The active Omni renderer uses the Gemini
# Developer API; this location is for the Gemini planning/critic agents.
GOOGLE_CLOUD_LOCATION=us-central1

# GCS bucket where Omni clips and final films are stored.
GCS_RENDER_BUCKET=your-render-bucket-name

# ── Gemini Omni Flash ────────────────────────────────────────────────────────
# Recommended production path. Store this in Secret Manager on Cloud Run; do
# not commit it and do not pass it through Cloud Build substitutions.
GEMINI_API_KEY=your-gemini-api-key
OMNI_MODEL_ID=gemini-omni-1.1-flash

OMNI_DAILY_CLIP_BUDGET=24

# Advisory duration bounds. Omni exposes no exact duration control, so the
# backend measures every returned MP4 with ffprobe and LOGS a warning when it
# falls outside this window. It does not reject the clip: discarding otherwise
# good video over a fraction of a second wastes a billable generation.
# Widen or narrow these to change what gets flagged, not what gets accepted.
OMNI_MIN_CLIP_SECONDS=1.0
OMNI_MAX_CLIP_SECONDS=12.0

OMNI_INTER_CLIP_DELAY_SECONDS=15
MAX_CONTINUITY_RETAKES_PER_FILM=4
REQUIRE_CHARACTER_REFERENCES=false
ALLOW_PARTIAL_FILMS=false

# How the Director's visual continuity gate treats a rendered clip.
#   enforce  - a shot joins the film only if the critic approves it. Strongest
#              claim, but a critic quota error can fail an otherwise good film.
#   advisory - the critic runs and its verdict is recorded; a clip it could not
#              verify is still used, and is labelled 'unverified' in the UI.
#   off      - no critic call. Every shot is labelled 'review_disabled'.
# No mode ever labels a clip director-approved without a real verdict.
CONTINUITY_REVIEW_MODE=advisory

# ── Grafana Cloud (MCP Observability) ─────────────────────────────────────────
# Your Grafana Cloud instance URL  e.g. https://yourstack.grafana.net
GRAFANA_URL=https://your-instance.grafana.net

# Grafana Cloud API key for the MCP server
GRAFANA_API_KEY=your-grafana-api-key

# Comma-separated browser origins allowed to call the API in local development.
# Cloud Run's static frontend is same-origin and needs no additional origin.
CORS_ORIGINS=http://localhost:3000

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Required only for multi-instance Cloud Run deployments (leader election + CRDT sync).
# Leave blank or unset to run in single-instance mode.
REDIS_URL=redis://localhost:6379
